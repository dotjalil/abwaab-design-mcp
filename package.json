{
  "name": "abwaab-design",
  "version": "0.1.0",
  "description": "AbwaabPlus design system docs + an MCP server that lets any agent read them.",
  "type": "module",
  "bin": {
    "abwaab-design-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "design-system",
    "functional",
    "README.md",
    "brand-alignment.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
